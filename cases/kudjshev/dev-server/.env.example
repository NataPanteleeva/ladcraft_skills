# Для prototype-flow обычно ничего не нужно: URL и token берутся из .cursor/mcp.json.
# PROTOTYPE_SKILLED_AGENT_URL / PROTOTYPE_SKILLED_AGENT_TOKEN нужны только если хотите
# принудительно переопределить источник prototype навыков.
# PROTOTYPE_SKILLED_AGENT_URL=  # optional override; by default inferred from .cursor/mcp.json
# PROTOTYPE_SKILLED_AGENT_TOKEN= # optional override; by default token is read from .cursor/mcp.json
# LADCRAFT_API_BASE_URL=https://api.dev.e-ai.ladcloud.ru
# LADCRAFT_REAUTH_URL=https://app.dev.e-ai.ladcloud.ru/
# LADCRAFT_TOKEN_REFRESH_HINT=Войдите через email/password или обновите access token вручную.
# Ladcraft access token в .env не хранится: dev-server держит его только в runtime-сессии.

DEV_SERVER_PORT=4321
WEB_UI_PORT=5174
