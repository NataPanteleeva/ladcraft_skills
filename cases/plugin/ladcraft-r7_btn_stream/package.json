{
  "name": "ladcraft-r7",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "npm run build:btn-stream",
    "build:base": "esbuild src/main.ts --bundle --outfile=dist/app.js --format=iife --global-name=LadcraftR7 --target=es2020 --define:__LC_PLUGIN_VARIANT__=\\\"base\\\"",
    "build:btn": "esbuild src/main.ts --bundle --outfile=dist/app.js --format=iife --global-name=LadcraftR7 --target=es2020 --define:__LC_PLUGIN_VARIANT__=\\\"btn\\\"",
    "build:btn-stream": "esbuild src/main.ts --bundle --outfile=dist/app.js --format=iife --global-name=LadcraftR7 --target=es2020 --define:__LC_PLUGIN_VARIANT__=\\\"btn_stream\\\"",
    "build:side": "esbuild src/main.ts --bundle --outfile=dist/app.js --format=iife --global-name=LadcraftR7 --target=es2020 --define:__LC_PLUGIN_VARIANT__=\\\"side\\\"",
    "verify": "node scripts/verify-build.js",
    "watch": "npm run build -- --watch",
    "typecheck": "tsc --noEmit",
    "smoke": "npx tsx scripts/smoke-docx-base64.ts"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0"
  }
}
